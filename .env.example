# ==========================================
# Kifo Platform - Environment Configuration
# ==========================================

# Environment
NODE_ENV=development
PLATFORM_DOMAIN=localhost

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://kifo:kifosecret@postgres:5432/kifo_db?schema=public
POSTGRES_USER=kifo
POSTGRES_PASSWORD=kifosecret
POSTGRES_DB=kifo_db

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# Discord OAuth2 Configuration
# ==========================================
DISCORD_CLIENT_ID=your_discord_app_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_platform_bot_token
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback
FRONTEND_URL=http://localhost:3000

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# Encryption (for bot tokens)
# ==========================================
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ==========================================
# AI Provider Configuration
# ==========================================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# ==========================================
# API Configuration
# ==========================================
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# ==========================================
# Runtime Worker Configuration
# ==========================================
RUNTIME_WORKER_PORT=5000
MAX_BOTS_PER_WORKER=50
WORKFLOW_CONCURRENCY=10

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ==========================================
# Object Storage (S3-compatible)
# ==========================================
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kifo-storage
S3_REGION=us-east-1
S3_USE_SSL=false

# ==========================================
# Observability
# ==========================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100

# ==========================================
# NATS (for future distributed messaging)
# ==========================================
NATS_URL=nats://nats:4222
